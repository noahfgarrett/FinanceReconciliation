    "eslint-plugin-react-refresh": "0.4.16",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.0",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "2.1.9"
