    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.18",
    "exceljs": "4.4.0",
    "idb": "8.0.0",
    "lucide-react": "0.400.0",
    "marked": "17.0.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "uuid": "10.0.0",
    "xlsx": "0.18.5",
    "zod": "3.23.8",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
